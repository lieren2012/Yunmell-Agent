# 云迈智能体控制面部署示例
# 复制为 .env.deploy 后按环境修改；不要把真实密码提交到 Git。

OCTOP_PORT=6602
OCTOP_DATA=/var/lib/yunmell-agent/control-plane-data
OCTOP_ADMIN_USERNAME=admin
OCTOP_DEFAULT_PASSWORD=replace-with-a-strong-password

# 生产环境建议使用 PostgreSQL；留空时使用控制面本地 SQLite。
# OCTOP_DATABASE_DRIVER=postgresql
# OCTOP_DATABASE_URL=postgresql://octop:change-me@postgres:5432/octop

# 可选：控制面直接托管的模型 Provider。也可以登录管理后台后配置。
# OPENAI_API_KEY=
# DASHSCOPE_API_KEY=
